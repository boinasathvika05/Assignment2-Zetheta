# NexBank Agentic AI Customer Service System - Environment Configuration

# Application Metadata
APP_NAME="NexBank Agentic AI"
APP_ENV="development"
APP_VERSION="1.0.0"
DEBUG=true
PORT=8000
HOST="0.0.0.0"
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5500","http://127.0.0.1:5500","http://localhost:8080","http://127.0.0.1:8080","http://localhost:8000","http://127.0.0.1:8000","null"]

# Database Configuration (PostgreSQL)
POSTGRES_USER=nexbank_user
POSTGRES_PASSWORD=nexbank_secure_pass_2026
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nexbank_ai_db
DATABASE_URL=postgresql+asyncpg://nexbank_user:nexbank_secure_pass_2026@localhost:5432/nexbank_ai_db

# Cache Configuration (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# Vector Database (ChromaDB)
CHROMA_PERSIST_DIRECTORY=./chroma_data
CHROMA_COLLECTION_NAME=nexbank_knowledge_base

# Security & Encryption
SECRET_KEY=nexbank_super_secret_jwt_key_change_in_production_2026
AES_ENCRYPTION_KEY=32_bytes_long_secret_encryption_key_2026_nexbank
SESSION_TIMEOUT_MINUTES=5

# LLM & Embedding Settings (Provider Agnostic)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3
OPENAI_API_KEY=your_openai_api_key_here

# System Thresholds & Guardrails
INTENT_CONFIDENCE_THRESHOLD=0.70
RETRIEVAL_CONFIDENCE_THRESHOLD=0.65
ESCALATION_SENTIMENT_THRESHOLD=-0.70
MAX_CONVERSATION_TURNS=25
GUARDRAIL_STRICTNESS=HIGH
